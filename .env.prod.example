# ── ms-conductores: configuración de producción (EC2) ─────────────────────
# Copia este archivo a .env en la EC2 y completa los valores reales.
# NUNCA versiones .env ni valores secretos.
#
# Las variables marcadas con [REQUERIDA] se deben completar antes de arrancar.
# Las marcadas con [PREVISTA] las leerá el código en un sprint futuro.

# Puerto HTTP del servicio (dentro del contenedor es 8085).
SERVER_PORT=8085

# ── Firebase / Firestore ────────────────────────────────────────────────────
# [REQUERIDA] Proyecto de Firebase real.
FIREBASE_PROJECT_ID=

# Ruta DENTRO del contenedor al JSON de la cuenta de servicio de Firebase.
# El archivo se monta como volumen de solo lectura (ver docker-compose.prod.yml).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-adminsdk.json

# Ruta en el HOST (EC2) al JSON de la cuenta de servicio de Firebase que se monta
# como volumen de solo lectura.
FIREBASE_CREDENTIALS_PATH=/home/ubuntu/credentials/firebase-adminsdk.json

# Timeout por operación de Firestore (formato Spring Duration, ej. 2s, 1500ms).
FIRESTORE_TIMEOUT=2s

# ── AWS (SNS/SQS) ───────────────────────────────────────────────────────────
# La EC2 debe tener el rol fleetops-conductores-ec2-role con permisos para
# publicar en el topic y consumir la cola. NO se definen llaves de acceso aquí.
AWS_REGION=us-east-1

# Endpoint de AWS. VACÍO en producción para usar AWS real (no LocalStack).
SPRING_CLOUD_AWS_ENDPOINT=

# [REQUERIDA] ARN del topic principal de eventos de conductores.
# Ejemplo: arn:aws:sns:us-east-1:123456789012:fleetops_driver_events
FLEETOPS_DRIVER_TOPIC_ARN=

# [REQUERIDA] URLs de la cola de conductores y de su DLQ.
# Ejemplo: https://sqs.us-east-1.amazonaws.com/123456789012/fleetops_driver_queue
FLEETOPS_DRIVER_QUEUE_URL=
FLEETOPS_DRIVER_DLQ_URL=

# ── Imagen Docker ───────────────────────────────────────────────────────────
# [REQUERIDA] Usuario de Docker Hub (secreto en GitHub Actions: DOCKERHUB_USERNAME).
DOCKERHUB_USER=

# Nombre de la imagen y etiqueta. En CD, IMAGE_TAG es el SHA completo del commit
# (github.sha); para main además se publica `latest`.
IMAGE_NAME=ms-conductores
IMAGE_TAG=latest

# ── Outbox [PREVISTA] ───────────────────────────────────────────────────────
OUTBOX_PUBLISH_INTERVAL_MS=2000

# ── Integración con Documentación [PREVISTA] ────────────────────────────────
DOCUMENTACION_URL=
DOCUMENTACION_TIMEOUT_MS=2000

# ── Circuit Breaker [PREVISTA] ──────────────────────────────────────────────
CIRCUIT_BREAKER_MAX_CONSECUTIVE_FAILURES=5
CIRCUIT_BREAKER_WAIT_DURATION_MS=30000
