# ── ms-conductores: configuración local ────────────────────────────────────
# Copia este archivo a .env y ajusta. NUNCA versiones .env.

# Puerto HTTP del servicio.
SERVER_PORT=8085

# ── Firebase / Firestore ────────────────────────────────────────────────────
# Proyecto de Firebase. En local se usa el emulador.
FIREBASE_PROJECT_ID=demo-conductores

# Emulador de Firestore para ejecutar con `./gradlew bootRun` (host).
# En Docker Compose el backend lo sobrescribe con firestore-emulator:8080.
FIREBASE_EMULATOR_HOST=localhost:8180

# Maximum wait for each Firestore call. It also caps the client retries and the /health check.
# Spring Duration format (e.g. 2s, 1500ms); must be at least 1ms or the service does not start.
# Initial value, pending validation in production.
FIRESTORE_TIMEOUT=2s

# Production: leave FIREBASE_EMULATOR_HOST empty and point to the service account.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── AWS (SNS/SQS locally with LocalStack) ──────────────────────────────────
# Dummy LocalStack values. Never put real credentials here.
# Production: do not set the keys or the endpoint (IAM role, real AWS).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SPRING_CLOUD_AWS_ENDPOINT=http://localhost:4566
