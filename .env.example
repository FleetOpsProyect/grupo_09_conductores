# Local configuration for ms-conductores.
# Copy this file to .env and adjust values. Never commit .env.

SERVER_PORT=8085
FIREBASE_PROJECT_ID=demo-conductores

# Local Gradle/bootRun: Firestore emulator exposed on localhost:8180.
# Docker Compose overrides this for the backend with firestore-emulator:8080.
FIREBASE_EMULATOR_HOST=localhost:8180

# Production: leave FIREBASE_EMULATOR_HOST empty and point to the service account.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
