# ── ms-conductores: configuración local ────────────────────────────────────
# Copia este archivo a .env y ajusta. NUNCA versiones .env.

# Puerto HTTP del servicio.
SERVER_PORT=8085

# ── Firebase / Firestore ────────────────────────────────────────────────────
# Proyecto de Firebase. En local se usa el emulador.
FIREBASE_PROJECT_ID=demo-conductores

# Emulador de Firestore para ejecutar con `./gradlew bootRun` (host).
# En Docker Compose el backend lo sobrescribe con firestore-emulator:8080.
FIREBASE_EMULATOR_HOST=localhost:8180

# Production: leave FIREBASE_EMULATOR_HOST empty and point to the service account.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
