# Copia este archivo a observability/.env (no se versiona).
#
# Elastic IP de la EC2 de ms-conductores. Prometheus la usa para leer los puertos 18001, 19100 y 18080,
# que el security group solo admite desde tu IP.
# Para probar contra tu propia máquina (docker compose de desarrollo y exporters locales), usa: host-gateway
EC2_IP=
